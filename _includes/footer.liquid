{%- assign email = site.data.socials.email | default: 'adnan.saood@ensta.fr' -%}
<footer class="site-footer" role="contentinfo">
  <div class="site-footer__cta reveal">
    <p class="kicker" data-i18n="Get in touch">Get in touch</p>
    <h2 class="site-footer__title"><span data-i18n="Let's talk">Let's talk</span> <span class="text-gradient" data-i18n="touch">touch</span>.</h2>
    <p class="site-footer__lede" data-i18n="Collaborations, student projects, talks, or robots that need a sense of touch.">Collaborations, student projects, talks, or robots that need a sense of touch.</p>
    <div class="site-footer__actions">
      <a class="btn btn--primary magnetic" href="mailto:{{ email | encode_email }}">
        <span>{{ email }}</span> <i class="ti ti-arrow-up-right" aria-hidden="true"></i>
      </a>
      <a class="btn btn--ghost magnetic" href="{{ '/contact/' | relative_url }}" data-i18n="Contact page">Contact page</a>
    </div>
  </div>

  <div class="site-footer__bottom">
    <nav class="site-footer__social" aria-label="Profiles">
      {% if site.data.socials.scholar_userid %}<a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" title="Google Scholar"><i class="ai ai-google-scholar"></i></a>{% endif %}
      {% if site.data.socials.github_username %}<a href="https://github.com/{{ site.data.socials.github_username }}" title="GitHub"><i class="ti ti-brand-github"></i></a>{% endif %}
      {% if site.data.socials.linkedin_username %}<a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}" title="LinkedIn"><i class="ti ti-brand-linkedin"></i></a>{% endif %}
      {% if site.data.socials.orcid_id %}<a href="https://orcid.org/{{ site.data.socials.orcid_id }}" title="ORCID"><i class="ai ai-orcid"></i></a>{% endif %}
      <a href="{{ '/cms/feed.php' | relative_url }}" title="RSS feed"><i class="ti ti-rss"></i></a>
    </nav>
    <p>
      &copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }} · U2IS, ENSTA Paris — Institut Polytechnique de Paris
    </p>
  </div>
</footer>
