{%- comment -%} Filled by assets/js/cms.js from the PHP CMS (see news.liquid). {%- endcomment -%}
<div class="news">
  <div class="table-responsive">
    <table class="table table-sm table-borderless">
      <tbody data-cms-fragment="posts" data-limit="{{ page.latest_posts.limit | default: 3 }}">
        <tr class="cms-loading"><td><span class="cms-skeleton"></span></td></tr>
      </tbody>
    </table>
  </div>
  <noscript><p><a href="{{ '/blog/' | relative_url }}">See all posts</a></p></noscript>
</div>
