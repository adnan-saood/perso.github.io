<header class="site-header" id="navbar">
  <div class="site-header__inner">
    <a class="brand" href="{{ '/' | relative_url }}" aria-label="{{ site.first_name }} {{ site.last_name }}, home">
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__name">{{ site.first_name }} <b>{{ site.last_name }}</b></span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {%- assign sorted_pages = site.pages | sort: 'nav_order' -%}
        {%- for p in sorted_pages -%}
          {%- if p.nav and p.autogen == null -%}
            {%- if p.permalink contains '://' -%}
              {%- assign url = p.permalink -%}
            {%- else -%}
              {%- assign url = p.url | remove: 'index.php' | remove: 'index.html' -%}
            {%- endif -%}
            {%- assign active = false -%}
            {%- if page.url == p.url -%}{%- assign active = true -%}{%- endif -%}
            {%- if url != '/' and page.url contains url -%}{%- assign active = true -%}{%- endif -%}
            <li>
              <a href="{{ url | relative_url }}" {% if active %}class="is-active" aria-current="page"{% endif %}>
                {{- p.title -}}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__tools">
      {% if site.search_enabled %}
        <button id="search-toggle" class="icon-btn" title="Search (Ctrl K)" onclick="openSearchModal()">
          <span class="nav-link"><i class="ti ti-search"></i></span>
        </button>
      {% endif %}
      {% if site.enable_darkmode %}
        <button id="light-toggle" class="icon-btn theme-toggle" title="Switch light / dark">
          <i class="ti ti-moon" aria-hidden="true"></i>
          <i class="ti ti-sun" aria-hidden="true"></i>
          <span class="sr-only">Switch light / dark theme</span>
        </button>
      {% endif %}
      <button class="menu-btn" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>
