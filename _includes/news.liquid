{%- comment -%}
  News now lives in the PHP CMS (edit it at /admin/). This placeholder is filled
  by assets/js/cms.js from cms/api.php so the homepage stays a static file.
{%- endcomment -%}
<div class="news">
  <div
    class="table-responsive"
    {% if include.limit and page.announcements.scrollable %}
      style="max-height: 60vw"
    {% endif %}
  >
    <table class="table table-sm table-borderless">
      <tbody
        data-cms-fragment="news"
        data-limit="{% if include.limit and page.announcements.limit %}{{ page.announcements.limit }}{% else %}50{% endif %}"
      >
        <tr class="cms-loading"><td><span class="cms-skeleton"></span><span class="cms-skeleton short"></span></td></tr>
      </tbody>
    </table>
  </div>
  <noscript><p><a href="{{ '/news/' | relative_url }}">See all news</a></p></noscript>
</div>
