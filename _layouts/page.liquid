---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <p class="kicker reveal">{% if page.kicker %}{{ page.kicker }}{% else %}{{ site.first_name }} {{ site.last_name }}{% endif %}</p>
    <h1 class="post-title split">{{ page.title }}</h1>
    {% if page.description %}<p class="post-description reveal">{{ page.description }}</p>{% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
